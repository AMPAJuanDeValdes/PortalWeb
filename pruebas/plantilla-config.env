# Plantilla de configuración de las pruebas. ejecutar-pruebas.bat la copia
# la primera vez a tu carpeta de usuario como  C:\Users\<tú>\ampa-pruebas.env
# y la abre para que la rellenes. Ese archivo queda FUERA del proyecto a
# propósito: la clave secreta no debe subirse nunca a GitHub ni a la web.

# Dirección de tu web en Netlify, sin barra al final
SITE_URL=https://tu-sitio.netlify.app

# Supabase → Project Settings → API Keys → Secret key (sb_secret_...)
# Es la misma que pusiste en Netlify como SUPABASE_SERVICE_ROLE_KEY
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Un email TUYO de Gmail (u otro que admita "+"). Las cuentas de prueba usarán
# variantes como tu.email+ampa-prueba-xxxx@gmail.com, así que los correos
# que manda el portal (bienvenida, contraseña, rechazo...) te llegarán a ti.
EMAIL_PRUEBAS=tu.email@gmail.com
